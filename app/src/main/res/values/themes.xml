<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style
        name="Base.Theme.ZDAdimsum"
        parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Font utama aplikasi -->
        <item name="android:fontFamily">@font/roboto_regular</item>
        <!-- Warna utama Lapangin -->
        <item name="colorPrimary">@color/lapangin_green</item>
        <item name="colorPrimaryVariant">@color/lapangin_dark_green</item>
        <item name="colorSecondary">@color/lapangin_teal</item>
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/lapangin_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/lapangin_background</item>
        <!-- Warna background -->
        <item name="android:windowBackground">@color/lapangin_background</item>

    </style>
    <!-- Theme aplikasi -->
    <style
        name="Theme.ZDAdimsum"
        parent="Base.Theme.ZDAdimsum">

    </style>

</resources>