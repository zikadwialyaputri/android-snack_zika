<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HALAMAN PILIH LAPANGAN -->

        <!-- HALAMAN FORM BOOKING -->
        <LinearLayout
            android:id="@+id/layoutFormBooking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnKembaliLapangan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹  Kembali ke Pilihan Lapangan"
                android:textColor="#287653"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tvBookingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nama Lapangan"
                android:textColor="#173F32"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBookingLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Lokasi Lapangan"
                android:textColor="#777777"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvHargaLapangan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Rp 0 / jam"
                android:textColor="#287653"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#DDDDDD" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Pilih Tanggal"
                android:textColor="#173F32"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPilihTanggal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Pilih tanggal booking"
                android:textColor="#555555"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Pilih Jam"
                android:textColor="#173F32"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerJam"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:paddingHorizontal="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Ringkasan Booking"
                android:textColor="#173F32"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvBookingSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Silakan pilih tanggal dan jam booking"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTotalHarga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Total: Rp 0"
                    android:textColor="#287653"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Button
                android:id="@+id/btnLanjutBooking"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#287653"
                android:text="Lanjut Booking"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutDaftarLapangan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Lapangan"
                android:textColor="#173F32"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Pilih lapangan yang ingin kamu booking"
                android:textColor="#777777"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progressLapangan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="25dp" />

            <TextView
                android:id="@+id/tvKosongLapangan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Belum ada lapangan tersedia"
                android:textColor="#777777"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/containerDaftarLapangan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
