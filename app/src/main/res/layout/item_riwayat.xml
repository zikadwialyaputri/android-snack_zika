<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_history_card"
    android:padding="16dp">

    <!-- NAMA GOR -->
    <TextView
        android:id="@+id/tvNama"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="GOR WIRA"
        android:textColor="#212121"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvStatus" />

    <!-- STATUS BOOKING -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Akan Datang"
        android:textColor="#8A6A20"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/tvNama"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ALAMAT -->
    <TextView
        android:id="@+id/tvLokasi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Jl. Siak, Gg. Melati, Pekanbaru"
        android:textColor="#777777"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/tvNama"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TANGGAL BOOKING -->
    <TextView
        android:id="@+id/tvTanggal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="22 November 2026"
        android:textColor="#555555"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvLokasi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- JAM BOOKING -->
    <TextView
        android:id="@+id/tvJam"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="16.00 - 17.00"
        android:textColor="#555555"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvTanggal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- GARIS PEMBATAS -->
    <View
        android:id="@+id/garisPembatas"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#E7E7E7"
        app:layout_constraintTop_toBottomOf="@id/tvJam"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- HARGA -->
    <TextView
        android:id="@+id/tvHarga"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Rp 60.000"
        android:textColor="#238B45"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/garisPembatas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- TOMBOL DETAIL -->
    <TextView
        android:id="@+id/btnDetail"
        android:layout_width="95dp"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_detail_button"
        android:gravity="center"
        android:text="Lihat Detail"
        android:textColor="#238B45"
        android:textSize="11sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/garisPembatas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
