<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imgLapangan"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/gor_wira"
        android:scaleType="centerCrop"
        android:contentDescription="Foto lapangan badminton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvNamaLapangan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="GOR WIRA"
        android:textColor="#174B31"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/imgLapangan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgLapangan" />

    <TextView
        android:id="@+id/tvLokasiLapangan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Pekanbaru, Riau"
        android:textColor="#777777"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tvNamaLapangan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNamaLapangan" />

    <TextView
        android:id="@+id/tvHargaLapangan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Rp 60.000 / jam"
        android:textColor="#238342"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/tvNamaLapangan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLokasiLapangan" />

</androidx.constraintlayout.widget.ConstraintLayout>